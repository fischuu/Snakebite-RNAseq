#!/usr/bin/env bash
# Stands in for STAR --runMode genomeGenerate in the escalation test: a job with less memory than this
# fails, and leaves a partial index, which is the case that would go unnoticed
while [ $# -gt 0 ]; do
    case "$1" in
        --genomeDir) dir=$2; shift ;;
    esac
    shift
done
mkdir -p "$dir"
if [ "${SLURM_MEM_PER_NODE:-0}" -lt 400 ]; then
    echo partial > "$dir/chrName.txt"
    echo "Pretending to run out of memory with ${SLURM_MEM_PER_NODE:-0} MB" >&2
    exit 1
fi
echo chr1 > "$dir/chrName.txt"
